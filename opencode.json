{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-5.6-terra",
  "plugin": ["@tarquinen/opencode-dcp"],
  "agent": {
    "plan": {
      "model": "github-copilot/gpt-5.6-sol"
    },
    "general": {
      "model": "github-copilot/gpt-5.6-terra"
    },
    "explore": {
      "model": "github-copilot/gpt-5.6-luna"
    },
    "scout": {
      "model": "github-copilot/gpt-5.6-luna"
    },
    "jira": {
      "description": "Jira and Confluence work via the Atlassian MCP: searching, reading, creating, updating, transitioning and commenting on issues, and reading or writing Confluence pages. This is the only agent with Atlassian tools enabled.",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.6-terra",
      "tools": {
        "atlassian_*": true
      }
    }
  },
  "tools": {
    "atlassian_*": false
  },
  "provider": {
    "azure-cognitive-services": {
      "whitelist": [
        "gpt-5.5-1"
      ],
      "options": {
        "apiVersion": "2024-12-01-preview",
        "useDeploymentBasedUrls": true,
        "useCompletionUrls": true
      },
      "models": {
        "gpt-5.5-1": {
          "name": "gpt-5.5-1"
        }
      }
    },
    "databricks": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Databricks AI Gateway",
      "whitelist": [
        "databricks-claude-opus-5",
        "databricks-claude-sonnet-5",
        "databricks-claude-opus-4-8",
        "databricks-claude-opus-4-7"
      ],
      "options": {
        "baseURL": "https://adb-3304658076883586.6.azuredatabricks.net/serving-endpoints",
        "apiKey": "{env:DATABRICKS_TOKEN}",
        "timeout": false,
        "headerTimeout": false
      },
      "models": {
        "databricks-claude-opus-5": {
          "name": "Claude Opus 5 via Databricks",
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "reasoning": true,
          "temperature": true
        },
        "databricks-claude-sonnet-5": {
          "name": "Claude Sonnet 5 via Databricks",
          "limit": {
            "context": 200000,
            "output": 32000
          },
          "reasoning": true,
          "temperature": true
        },
        "databricks-claude-opus-4-8": {
          "name": "Claude Opus 4.8 via Databricks",
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "reasoning": true,
          "temperature": true
        },
        "databricks-claude-opus-4-7": {
          "name": "Claude Opus 4.7 via Databricks",
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "reasoning": true,
          "temperature": true
        }
      }
    }
  },
  "skills": {
    "paths": [
      "C:\\Users\\maja2811\\work\\bi-dlh-documentation\\skills\\dlh-platform",
      "C:\\Users\\maja2811\\work\\bi-dlh-helper\\dlh_dmt_helper\\skills"
    ]
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "*git commit*": "ask",
      "*git push*": "ask"
    }
  }
}
