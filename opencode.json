{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-6.1-sol",
  "plugins": ["@tarquinen/opencode-dcp"],
  "agents": {
    "plan": {
      "model": "github-copilot/gpt-6.1-sol"
    },
    "general": {
      "model": "github-copilot/gpt-6-luna#high"
    },
    "explore": {
      "model": "github-copilot/gpt-6-luna#high"
    },
    "title": {
      "model": "github-copilot/gpt-6-luna#high"
    },
    "jira": {
      "description": "Jira and Confluence work via the Atlassian MCP: searching, reading, creating, updating, transitioning and commenting on issues, and reading or writing Confluence pages. This is the only agent with Atlassian tools enabled.",
      "mode": "subagent",
      "model": "github-copilot/gpt-6-luna#high",
      "permissions": [
        { "action": "atlassian_*", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "providers": {
    "azure": {
      "settings": {
        "resourceName": "oai-dlh-ctr-ctm-dev-sdc-001"
      },
      "models": {
        "gpt-6.1-sol": {},
        "gpt-6-luna": {},
        "claude-opus-5-5": {}
      }
    },
    "databricks": {
      "name": "Databricks AI Gateway",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://adb-3304658076883586.6.azuredatabricks.net/serving-endpoints",
        "timeout": false,
        "headerTimeout": false
      },
      "models": {
        "databricks-claude-opus-5": {
          "name": "Claude Opus 5 via Databricks",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "databricks-claude-sonnet-5": {
          "name": "Claude Sonnet 5 via Databricks",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "databricks-claude-opus-4-8": {
          "name": "Claude Opus 4.8 via Databricks",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "databricks-claude-opus-4-7": {
          "name": "Claude Opus 4.7 via Databricks",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        }
      }
    }
  },
  "skills": [
    "C:\\Users\\maja2811\\work\\bi-dlh-documentation\\skills\\dlh-platform",
    "C:\\Users\\maja2811\\work\\bi-dlh-helper\\dlh_dmt_helper\\skills"
  ],
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2",
        "disabled": false
      }
    }
  },
  "permissions": [
    { "action": "atlassian_*", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git commit", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git -C * commit *", "effect": "ask" },
    { "action": "shell", "resource": "git -C * push *", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/.review-pr-tmp/*", "effect": "allow" }
  ]
}
